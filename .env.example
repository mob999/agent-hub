NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://agent_hub:agent_hub@localhost:5432/agent_hub
DATABASE_POOL_MAX=3
REDIS_URL=redis://localhost:6379
AUTH_SESSION_COOKIE=agent_hub_session
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AGENTHUB_DAEMON_TOKEN=dev-daemon-token
# Production only: shared by API and Worker to derive per-device daemon tokens.
# AGENTHUB_DAEMON_TOKEN_SECRET=replace-with-a-long-random-secret
AGENTHUB_DEFAULT_DAEMON_DEVICE_ID=local-dev
AGENTHUB_DEFAULT_AGENT_ID=codex
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback
WORKER_PORT=3001
AGENTHUB_DAEMON_GATEWAY_URL=http://localhost:3001
AGENTHUB_DEVICE_ID=local-dev
# Agent workspaces default to the current user's ~/.agent-hub directory.
# Optional: override detected runtime executables when the daemon runs locally.
# CODEX_EXECUTABLE_PATH=codex
# CLAUDE_CODE_EXECUTABLE_PATH=claude-cc-deepseek
AGENTHUB_STORAGE_ROOT=.agent-hub/storage
AGENTHUB_PUBLIC_API_URL=http://localhost:3000
AGENTHUB_PUBLIC_WEB_URL=http://localhost:5173
AGENTHUB_CONTEXT_COMPACT_CHAR_THRESHOLD=60000
AGENTHUB_DAILY_MEMORY_REFRESH_INTERVAL_MINUTES=240
AGENTHUB_DAILY_MEMORY_REFRESH_TRANSCRIPT_MAX_BYTES=60000
