{
  "name": "@agent-hub/worker",
  "version": "0.0.0",
  "private": true,
  "description": "AgentHub background worker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "type": "module",
  "dependencies": {
    "@agent-hub/config": "workspace:*",
    "@agent-hub/core": "workspace:*",
    "@agent-hub/db": "workspace:*",
    "@agent-hub/server": "workspace:*",
    "redis": "^5.12.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
